
# mbkbucket
BucketConnection={"R2_Bucket":{"BUCKET_NAME":"","ACCESS_KEY_ID":"","SECRET_ACCESS_KEY":"","ENDPOINT":""}}
mbkbucketVar={"publiView_enabled":"true","p_view_inline":"true"}


NEON_POSTGRES=postgresql://
PORT=3126

DEBUG=mbkauthe*
# Set to mbkauthe* to enable debug logs for all mbkauthe modules.

DEBUG=mbkbucket*
# Set to mbkbucket* to enable debug logs for all mbkbucket modules.


mbkautheVar={"APP_NAME":"mbkauthe","loginRedirectURL":"\/dashboard","bucket":"R2_Bucket","CLI_AUTH_BASE_URL":"","CLI_AUTH_ENABLED":"true"}
mbkauthShared={"Main_SECRET_TOKEN": 123,"DOMAIN":"mbktech.org","IS_DEPLOYED":"false","DEVICE_TRUST_DURATION_DAYS":7,"SESSION_SECRET_KEY":"123","DB_TYPE":"postgres","LOGIN_DB":"postgres://","MBKAUTH_TWO_FA_ENABLE":"true","COOKIE_EXPIRE_TIME":2,"GITHUB_LOGIN_ENABLED":"f","GOOGLE_LOGIN_ENABLED":"f","GOOGLE_CLIENT_ID":"123","GOOGLE_CLIENT_SECRET":"123"}
# CLI_AUTH_BASE_URL: optional absolute base URL used to build the CLI device-flow
# verification URL (e.g. "https://portal.mbktech.org"). Leave empty to derive it
# from DOMAIN (when deployed) or the request host (in dev).
# CLI_AUTH_ENABLED: "true" (default) attaches the CLI device-flow login to the
# main router; set "false" to disable it.
# SQLite backend (no database server required): replace "LOGIN_DB":"postgres://" above with
# "DB_TYPE":"sqlite","SQLITE_PATH":"./data/mbkauthe.sqlite"
# then run `npm run create-tables`. See docs/guides/configuration.md.
# See docs/env.md for more details