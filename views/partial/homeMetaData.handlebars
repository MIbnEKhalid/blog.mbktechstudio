{{#section 'styles'}}
<title>MBK Tech Blog | Tech Insights & Tutorials</title>
<meta name="description" content="MBK Tech Blog - Insights on Technology, Development, and Innovation">
<meta name="keywords" content="Tech Blog, Software Development Blog, Programming Tutorials, Tech Industry News, MBK Tech">
{{#if uniqueAuthors.length}}
<meta name="author" content="{{#each uniqueAuthors}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}">
{{else}}
<meta name="author" content="MBK Tech">
{{/if}}
<meta property="og:title" content="MBK Tech Blog | Tech Insights & Tutorials" />
<meta property="og:description" content="Discover in-depth articles, tutorials, and insights about software development, technology trends, and innovation." />
<meta property="og:image" content="/Assets/Images/Icon/logo.png" />
<meta property="og:url" content="https://blog.mbktech.org/">
<meta property="og:type" content="blog" />
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="MBK Tech Blog | Tech Insights & Tutorials">
<meta name="twitter:description" content="Discover in-depth articles, tutorials, and insights about software development, technology trends, and innovation.">
<meta name="twitter:image" content="/Assets/Images/Icon/logo.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "MBK Tech Blog",
  "url": "https://blog.mbktech.org/",
  "logo": "/Assets/Images/Icon/logo.png",
  "description": "Explore tech insights, tutorials, and industry trends. Your source for software development knowledge and innovation.",
  "publisher": {
    "@type": "Organization",
    "name": "MBK Tech",
    "url": "https://www.mbktech.org",
    "logo": {
      "@type": "ImageObject",
      "url": "/Assets/Images/Icon/logo.png"
    },
    "sameAs": [
      "https://github.com/MIbnEKhalid",
      "https://youtube.com/@mibnekhalid"
    ]
  },
  "author": [
    {{#if uniqueAuthors.length}}
      {{#each uniqueAuthors}}
      {
        "@type": "Person",
        "name": "{{this}}",
        "url": "https://blog.mbktech.org/author/{{this}}"
      }{{#unless @last}},{{/unless}}
      {{/each}}
    {{else}}
      {
        "@type": "Person",
        "name": "MBK Tech Authors",
        "url": "https://blog.mbktech.org"
      }
    {{/if}}
  ]
}
</script>
{{/section}}