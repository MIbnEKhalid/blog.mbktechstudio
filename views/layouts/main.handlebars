<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- STRICT BOT & AI BLOCKING -->
    <meta name="robots" content="noai, noimageai, nofollow, noarchive, nosnippet, notranslate">
    <meta name="googlebot" content="noai, noimageai, nofollow, noarchive, nosnippet">
    <meta name="bingbot" content="noai, noimageai, nofollow, noarchive, nosnippet">
    <meta name="referrer" content="no-referrer">
    {{#if canonicalUrl}}
    <link rel="canonical" href="{{canonicalUrl}}" />
    {{/if}}
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">
    
    <!-- Modular Blog Styles -->
    <link rel="stylesheet" href="/Assets/blog-main.css?v={{cacheBuster}}">
    <link rel="stylesheet" href="/Assets/markdown.css?v={{cacheBuster}}">
    <link rel="stylesheet" href="/Assets/post-card.css?v={{cacheBuster}}">
    <link rel="stylesheet" href="/Assets/search-filter.css?v={{cacheBuster}}">

    <!-- Syntax Highlighting & Core Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js" defer></script>
    <script src="/Assets/Scripts/blog-main.js?v={{cacheBuster}}" defer></script>
    <script src="/Assets/Scripts/markdown-enhancer.js?v={{cacheBuster}}" defer></script>
    <script src="/mbkauthe/main.js" defer></script>

    {{{_sections.styles}}}
</head>

<body data-current-user="{{user.username}}">
    <!-- Header -->
    <header>
        <div class="header-container">
            <a href="/" class="logo-brand">
                <i class="fas fa-layer-group"></i>
                <span>MBK <span>Tech</span></span>
                <span class="brand-badge">BLOG</span>
            </a>

            <nav>
                <ul>
                    <li><a href="/" title="Go to homepage"><i class="fas fa-home"></i> Home</a></li>
                    <li><a href="/categories" title="View all categories"><i class="fas fa-folder"></i> Categories</a></li>
                    <li><a href="/tags" title="View all tags"><i class="fas fa-tags"></i> Tags</a></li>
                    <li><a href="/bookmarks" title="View bookmarked posts"><i class="fas fa-bookmark"></i> Bookmarks</a></li>
                    {{#if user}}
                    <li style="display: flex; align-items: center; gap: 0.4rem;">
                        <a href="/dashboard" class="nav-btn-highlight" title="Go to Admin Dashboard" style="display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.85rem;">
                            <div class="user-nav-avatar" style="width: 22px; height: 22px; border-radius: 50%; background: var(--primary); color: #fff; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; flex-shrink: 0;">
                                {{#if profileImageUrl}}
                                <img src="{{profileImageUrl}}" alt="{{user.username}}" style="width: 100%; height: 100%; object-fit: cover;" class="user-cookie-avatar">
                                {{else}}
                                <span>{{firstLetter (coalesce user.username 'A')}}</span>
                                {{/if}}
                            </div>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <button onclick="logout()" class="btn btn-secondary btn-sm" title="Logout" style="border-radius: var(--radius-full);">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </li>
                    {{else}}
                    <li>
                        <a href="/mbkauthe/login" class="nav-btn-highlight" title="Login to your account">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </li>
                    {{/if}}
                </ul>
            </nav>

            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle Menu">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div class="mobile-menu" id="mobileMenu">
            <ul>
                <li><a href="/" title="Go to homepage"><i class="fas fa-home"></i> Home</a></li>
                <li><a href="/categories" title="View all categories"><i class="fas fa-folder"></i> Categories</a></li>
                <li><a href="/tags" title="View all tags"><i class="fas fa-tags"></i> Tags</a></li>
                <li><a href="/bookmarks" title="View bookmarked posts"><i class="fas fa-bookmark"></i> Bookmarks</a></li>
                {{#if user}}
                <li><a href="/dashboard" class="nav-btn-highlight"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                <li><a href="javascript:void(0)" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                {{else}}
                <li><a href="/mbkauthe/login" class="nav-btn-highlight"><i class="fas fa-sign-in-alt"></i> Login</a></li>
                {{/if}}
            </ul>
        </div>
    </header>

    <main>
        {{{body}}}
    </main>

    <!-- Footer -->
    <footer>
        <div class="footer-container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <h4>
                        <i class="fas fa-layer-group" style="color: var(--primary);"></i>
                        MBK <span>Tech Blog</span>
                    </h4>
                    <p>Empowering developers through open-source technology, modern full-stack development, and cloud-native architecture.</p>
                </div>

                <div class="footer-section">
                    <h5>Explore</h5>
                    <ul>
                        <li><a href="/"><i class="fas fa-angle-right"></i> Latest Posts</a></li>
                        <li><a href="/categories"><i class="fas fa-angle-right"></i> All Categories</a></li>
                        <li><a href="/tags"><i class="fas fa-angle-right"></i> Popular Tags</a></li>
                        <li><a href="/bookmarks"><i class="fas fa-angle-right"></i> Saved Bookmarks</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>Ecosystem</h5>
                    <ul>
                        <li><a href="https://mbktech.org" target="_blank" rel="noopener noreferrer"><i class="fas fa-external-link-alt"></i> MBK Tech Main</a></li>
                        <li><a href="https://docs.mbktech.org" target="_blank" rel="noopener noreferrer"><i class="fas fa-external-link-alt"></i> Documentation</a></li>
                        <li><a href="https://portfolio.mbktech.org" target="_blank" rel="noopener noreferrer"><i class="fas fa-external-link-alt"></i> Portfolio</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>Connect</h5>
                    <ul>
                        <li><a href="https://github.com/MIbnEKhalid" target="_blank" rel="noopener noreferrer"><i class="fab fa-github"></i> GitHub</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; <script>document.write(new Date().getFullYear())</script> MBKTech.org. All rights reserved.</p>
                <p>Designed with MBKBucket Design System.</p>
            </div>
        </div>
    </footer>

    <script src="/Assets/Scripts/preloader.js?v={{cacheBuster}}" defer></script>
</body>

</html>