{{#section 'styles'}}
<link rel="stylesheet" href="/Assets/blog-archive.css?v={{cacheBuster}}">
<script src="/Assets/Scripts/bookmarks.js?v={{cacheBuster}}" defer></script>
<title>My Bookmarks - MBK Tech Blog</title>
<meta name="description" content="View and manage all your bookmarked blog posts">
<meta name="robots" content="noindex, nofollow">
{{/section}}

<div class="section-container">
    <div class="bookmarks-header-card">
        <h1><i class="fas fa-bookmark"></i> Saved Articles</h1>
        <p>Your personal reading list saved directly in your browser. Read offline or anytime.</p>

        {{#if posts.length}}
        <div class="bookmarks-stats">
            <div class="stat-pill">
                <i class="fas fa-bookmark"></i>
                <span>{{posts.length}} saved article{{#unless (eq posts.length 1)}}s{{/unless}}</span>
            </div>
            <div class="stat-pill">
                <i class="fas fa-clock"></i>
                <span id="totalReadingTime">0 min</span> total read time
            </div>
        </div>

        <div class="bookmarks-actions">
            <a href="/" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Blog
            </a>
            <button onclick="exportBookmarks()" class="btn btn-outline">
                <i class="fas fa-download"></i> Export JSON
            </button>
            <button onclick="clearAllBookmarks()" class="btn btn-danger btn-sm" style="border-radius: var(--radius-md);">
                <i class="fas fa-trash-alt"></i> Clear All
            </button>
        </div>
        {{/if}}
    </div>

    {{#if posts.length}}
    <div class="posts-grid">
        {{#each posts}}
        {{> partial/postCard isBookmarksPage=true}}
        {{/each}}
    </div>
    {{else}}
    <div class="empty-state">
        <div class="empty-state-icon"><i class="fas fa-bookmark"></i></div>
        <h2>No Bookmarks Yet</h2>
        <p>Save interesting articles by clicking the bookmark button on any post to read them anytime.</p>
        <a href="/" class="btn btn-primary">
            <i class="fas fa-compass"></i> Discover Articles
        </a>
    </div>
    {{/if}}
</div>