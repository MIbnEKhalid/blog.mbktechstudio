{{> partial/postMetaData}}

<!-- Reading Progress Bar -->
<div class="reading-progress-bar" id="readingProgressBar"></div>

<div class="section-container post-page-container" data-post-author="{{post.UserName}}">
    <div class="post-detail-layout">

        <!-- 1. Left Action Rail (Sticky on Desktop) -->
        <aside class="post-left-rail" aria-label="Quick Actions">
            <div class="sticky-rail-box">
                <button type="button" class="rail-action-btn" id="railBookmarkBtn" onclick="toggleBookmark('{{post.id}}', '{{post.slug}}', '{{post.title}}')" title="Save Bookmark">
                    <i class="far fa-bookmark"></i>
                </button>
                <div class="rail-separator"></div>
                <button type="button" class="rail-action-btn native-share-btn" onclick="nativeWebShare('{{post.title}}', 'https://blog.mbktech.org/post/{{post.slug}}', '{{post.excerpt}}')" title="Share Article">
                    <i class="fas fa-share-alt"></i>
                </button>
                <a href="https://twitter.com/intent/tweet?url=https://blog.mbktech.org/post/{{post.slug}}&text={{encodeURIComponent post.title}}"
                    target="_blank" rel="noopener noreferrer" class="rail-action-btn" title="Share on Twitter / X">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://blog.mbktech.org/post/{{post.slug}}"
                    target="_blank" rel="noopener noreferrer" class="rail-action-btn" title="Share on LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
                <a href="https://api.whatsapp.com/send?text={{encodeURIComponent post.title}}%20https://blog.mbktech.org/post/{{post.slug}}"
                    target="_blank" rel="noopener noreferrer" class="rail-action-btn whatsapp" title="Share on WhatsApp">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <button type="button" class="rail-action-btn" onclick="copyPostLink()" title="Copy Link">
                    <i class="fas fa-link"></i>
                </button>
            </div>
        </aside>

        <!-- 2. Main Article Column -->
        <main class="article-main-column">
            <article class="article-card" id="mainArticle" data-post-id="{{post.id}}">
                <div class="article-header">
                    <div class="article-breadcrumbs">
                        <a href="/"><i class="fas fa-home"></i> Home</a>
                        <span>/</span>
                        {{#if post.category_names}}
                        <a href="/category/{{encodeURIComponent (index post.category_names 0)}}">{{index post.category_names 0}}</a>
                        <span>/</span>
                        {{/if}}
                        <span>Article</span>
                    </div>

                    <!-- Upper Area: Categories and Tags -->
                    <div class="article-meta-badges-row">
                        {{#if post.category_names}}
                        <a href="/category/{{encodeURIComponent (index post.category_names 0)}}" class="article-category-badge">
                            <i class="fas fa-folder-open"></i>
                            <span>{{index post.category_names 0}}</span>
                        </a>
                        {{/if}}

                        {{#if post.tags}}
                        <div class="article-header-tags">
                            {{#each post.tags}}
                            <a href="/tag/{{this.name}}" class="tag-pill">#{{this.name}}</a>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>

                    <h1 class="article-title">
                        {{post.title}}
                        {{#if isLogin}}
                        <a href="/dashboard/posts/edit/{{post.id}}" class="edit-link" title="Edit this post">
                            <i class="fas fa-edit"></i>
                        </a>
                        {{/if}}
                    </h1>

                    <div class="article-meta">
                        <div class="author-meta-block">
                            <div class="author-avatar" data-username="{{post.UserName}}">
                                {{#if post.author_image}}
                                <img src="{{post.author_image}}" alt="{{post.UserName}}">
                                {{else}}
                                <span class="avatar-initials">{{firstLetter post.UserName}}</span>
                                {{/if}}
                            </div>
                            <div class="author-info-wrap">
                                <a href="/author/{{post.UserName}}">{{post.UserName}}</a>
                                <span class="publish-date">Published on {{formatDate post.created_at}}</span>
                            </div>
                        </div>

                        <div class="meta-pills-group">
                            <span class="meta-pill">
                                <i class="fas fa-clock"></i>
                                {{formatReadingTime post.content_markdown}}
                            </span>
                            <span class="meta-pill">
                                <i class="fas fa-eye"></i>
                                <span id="post-views">{{post.views}}</span> views
                            </span>
                        </div>
                    </div>
                </div>

                {{#if post.preview_image}}
                <div class="article-preview-img">
                    <img src="{{post.preview_image}}" alt="{{post.title}}" loading="lazy" class="zoomable-img">
                </div>
                {{/if}}

                <!-- Mobile / Tablet Inline Share & Actions Bar -->
                <div class="post-actions mobile-post-actions">
                    <div class="share-group">
                        <span class="share-label">Share:</span>
                        <button class="share-btn native-share-btn" id="nativeShareBtn" onclick="nativeWebShare('{{post.title}}', 'https://blog.mbktech.org/post/{{post.slug}}', '{{post.excerpt}}')" title="Share article">
                            <i class="fas fa-share-alt"></i>
                        </button>
                        <a href="https://twitter.com/intent/tweet?url=https://blog.mbktech.org/post/{{post.slug}}&text={{encodeURIComponent post.title}}"
                            target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on Twitter / X">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://blog.mbktech.org/post/{{post.slug}}"
                            target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=https://blog.mbktech.org/post/{{post.slug}}"
                            target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://api.whatsapp.com/send?text={{encodeURIComponent post.title}}%20https://blog.mbktech.org/post/{{post.slug}}"
                            target="_blank" rel="noopener noreferrer" class="share-btn whatsapp" title="Share on WhatsApp">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                        <button class="share-btn copy-link-btn" onclick="copyPostLink()" title="Copy Link">
                            <i class="fas fa-link"></i>
                            <span class="copy-feedback" id="copyFeedback">Link Copied!</span>
                        </button>
                    </div>

                    <div class="action-tools-group">
                        <div class="font-resizer" title="Adjust reader text size">
                            <button class="font-resizer-btn" onclick="changeFontSize(-1)" title="Smaller text">A-</button>
                            <button class="font-resizer-btn" onclick="changeFontSize(1)" title="Larger text">A+</button>
                        </div>

                        <button class="action-btn" id="bookmarkBtn"
                            onclick="toggleBookmark('{{post.id}}', '{{post.slug}}', '{{post.title}}')">
                            <i class="far fa-bookmark"></i>
                            <span id="bookmarkText">Bookmark</span>
                        </button>
                    </div>
                </div>

                <!-- Mobile / Tablet Inline Table of Contents Insertion -->
                <div id="tocContainer" class="toc-wrapper mobile-toc-wrapper"></div>

                <!-- Markdown Body Content -->
                <div class="markdown-content" id="markdownContent">
                    {{{post.content_html}}}
                </div>

                <!-- Author Bio Box -->
                <div class="author-bio-card">
                    <div class="author-bio-avatar" data-username="{{post.UserName}}">
                        {{#if post.author_image}}
                        <img src="{{post.author_image}}" alt="{{post.UserName}}">
                        {{else}}
                        <span class="avatar-initials">{{firstLetter post.UserName}}</span>
                        {{/if}}
                    </div>
                    <div class="author-bio-info">
                        <h3>Written by {{post.UserName}}</h3>
                        <p>Contributing writer and developer at MBK Tech. Sharing deep dives, tutorials, and insights into full-stack development and cloud engineering.</p>
                        <a href="/author/{{post.UserName}}">View all articles by {{post.UserName}} <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </article>

            {{#if relatedPosts.length}}
            <!-- Related Articles Recommendations Grid -->
            <section class="related-posts-section" aria-label="Related Articles">
                <div class="related-header">
                    <h2 class="related-title">
                        <i class="fas fa-layer-group"></i>
                        Related Articles
                    </h2>
                    <a href="/" class="related-view-all">All Articles <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="related-posts-grid">
                    {{#each relatedPosts}}
                    <article class="related-card">
                        <a href="/post/{{this.slug}}" class="related-img-wrap" aria-label="{{this.title}}">
                            {{#if this.preview_image}}
                            <img src="{{this.preview_image}}" alt="{{this.title}}" loading="lazy">
                            {{else}}
                            <div class="related-img-placeholder">
                                <i class="fas fa-newspaper"></i>
                            </div>
                            {{/if}}
                        </a>
                        <div class="related-body">
                            <div class="related-meta-top">
                                {{#if this.categories}}
                                <span class="related-cat-badge">{{this.categories}}</span>
                                {{else}}
                                <span class="related-cat-badge">Article</span>
                                {{/if}}
                                <span class="related-time"><i class="fas fa-clock"></i> {{formatReadingTime this.content_markdown}}</span>
                            </div>
                            <h3 class="related-card-title">
                                <a href="/post/{{this.slug}}">{{this.title}}</a>
                            </h3>
                            <div class="related-footer">
                                <span class="related-author">
                                    {{#if this.author_image}}
                                    <img src="{{this.author_image}}" alt="{{this.UserName}}" class="related-author-avatar">
                                    {{else}}
                                    <span class="related-author-avatar-fallback">{{firstLetter this.UserName}}</span>
                                    {{/if}}
                                    <span class="related-author-name">{{this.UserName}}</span>
                                </span>
                                <a href="/post/{{this.slug}}" class="related-read-link">Read <i class="fas fa-chevron-right"></i></a>
                            </div>
                        </div>
                    </article>
                    {{/each}}
                </div>
            </section>
            {{/if}}

            <!-- Comments Section -->
            <section class="comments-section">
                <h2 class="comments-title">
                    <i class="fas fa-comments" style="color: var(--primary);"></i>
                    Member Discussion
                </h2>

                <div class="comments-note">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <strong>Authorized Discussion:</strong> Comments and discussions are active for MBK Tech community members.
                    </div>
                </div>

                {{#if user}}
                <form id="commentForm" class="comment-form" action="/post/{{post.slug}}/comment" method="POST">
                    <div class="comment-form-header">
                        <div class="comment-user-badge">
                            <div class="comment-avatar" data-current-user="true">
                                {{#if profileImageUrl}}
                                <img src="{{profileImageUrl}}" alt="{{user.username}}">
                                {{else}}
                                <span class="avatar-initials">{{firstLetter (coalesce user.username 'U')}}</span>
                                {{/if}}
                            </div>
                            <span style="font-weight: 700; color: var(--dark-color-ml); font-size: 0.9rem;">{{coalesce user.username 'Member'}}</span>
                        </div>
                    </div>
                    <div id="replyingTo" class="replying-to-bar" style="display: none;">
                        <span>Replying to <strong id="replyingToName"></strong></span>
                        <button type="button" onclick="cancelReply()"><i class="fas fa-times"></i> Cancel</button>
                    </div>
                    <input type="hidden" name="parent_id" id="parentCommentId" value="">
                    <textarea name="content" class="comment-textarea" rows="3" required placeholder="Share your insights, ask questions, or contribute feedback..."></textarea>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> Post Comment
                    </button>
                </form>
                {{else}}
                <div class="comment-form" style="text-align: center; padding: 2rem;">
                    <p style="color: var(--text-muted); margin-bottom: 1.25rem;">Sign in to join the discussion or leave a reply.</p>
                    <a href="/mbkauthe/login" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt"></i> Login to Comment
                    </a>
                </div>
                {{/if}}

                <!-- Comments List -->
                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    {{#each comments}}
                    {{#unless this.parent_id}}
                    <div class="comment-thread">
                        <!-- Parent comment -->
                        <div class="comment-card">
                            <div class="comment-header">
                                <div class="comment-author-wrap">
                                    <div class="comment-avatar" data-username="{{this.UserName}}">
                                        {{#if this.author_image}}
                                        <img src="{{this.author_image}}" alt="{{this.UserName}}">
                                        {{else}}
                                        <span class="avatar-initials">{{firstLetter this.UserName}}</span>
                                        {{/if}}
                                    </div>
                                    <div>
                                        <div class="comment-author">
                                            <a href="/author/{{this.UserName}}">{{this.UserName}}</a>
                                            {{#unless this.is_approved}}
                                             <span class="badge" style="background: var(--yellow-lt); color: var(--yellow); font-size: 0.75rem; padding: 0.1rem 0.4rem; border-radius: var(--radius-full); margin-left: 0.4rem;">Pending</span>
                                            {{/unless}}
                                        </div>
                                    </div>
                                </div>
                                <span class="comment-date">{{formatDate this.created_at}}</span>
                            </div>

                            <div class="comment-body">{{this.content}}</div>

                            <div class="comment-actions">
                                {{#if ../user}}
                                <button onclick="replyToComment('{{this.id}}', '{{this.UserName}}')" class="comment-reply-btn">
                                    <i class="fas fa-reply"></i> Reply
                                </button>
                                {{/if}}

                                {{#if ../isSuperAdmin}}
                                {{#unless this.is_approved}}
                                <button onclick="approveComment('{{this.id}}')" class="btn btn-success btn-sm">
                                    <i class="fas fa-check"></i> Approve
                                </button>
                                {{/unless}}
                                <button onclick="deleteComment('{{this.id}}')" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                                {{/if}}
                            </div>
                        </div>

                        <!-- Nested replies -->
                        {{#each ../comments as |reply|}}
                        {{#if (eq reply.parent_id ../this.id)}}
                        {{#if @first}}
                        <div class="reply-toggle" onclick="toggleReplies({{../this.id}})" style="margin-left: 2rem;">
                            <i class="fas fa-caret-right" id="caret-{{../this.id}}"></i>
                            <span id="reply-count-{{../this.id}}">Show replies ({{../this.replyCount}})</span>
                        </div>
                        {{/if}}
                        {{/if}}
                        {{/each}}

                        <div id="replies-{{this.id}}" class="replies-nested-wrap" style="display: none;">
                            {{#each ../comments}}
                            {{#if (eq this.parent_id ../this.id)}}
                            <div class="comment-card">
                                <div class="comment-header">
                                    <div class="comment-author-wrap">
                                        <div class="comment-avatar" data-username="{{this.UserName}}">
                                            {{#if this.author_image}}
                                            <img src="{{this.author_image}}" alt="{{this.UserName}}">
                                            {{else}}
                                            <span class="avatar-initials">{{firstLetter this.UserName}}</span>
                                            {{/if}}
                                        </div>
                                        <div class="comment-author">
                                            <a href="/author/{{this.UserName}}">{{this.UserName}}</a>
                                            {{#unless this.is_approved}}
                                            <span class="badge" style="background: var(--yellow-lt); color: var(--yellow); font-size: 0.75rem; padding: 0.1rem 0.4rem; border-radius: var(--radius-full); margin-left: 0.4rem;">Pending</span>
                                            {{/unless}}
                                        </div>
                                    </div>
                                    <span class="comment-date">{{formatDate this.created_at}}</span>
                                </div>
                                <div class="comment-body">{{this.content}}</div>
                                {{#if ../../isSuperAdmin}}
                                <div class="comment-actions">
                                    {{#unless this.is_approved}}
                                    <button onclick="approveComment('{{this.id}}')" class="btn btn-success btn-sm">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                    {{/unless}}
                                    <button onclick="deleteComment('{{this.id}}')" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                                {{/if}}
                            </div>
                            {{/if}}
                            {{/each}}
                        </div>
                    </div>
                    {{/unless}}
                    {{else}}
                    <div class="empty-state" style="padding: 2rem;">
                        <p style="color: var(--text-muted); margin: 0;">No comments on this article yet. Be the first to start the discussion!</p>
                    </div>
                    {{/each}}
                </div>
            </section>
        </main>

        <!-- 3. Right Sticky Sidebar (Outline, Author Mini Profile & Reading Stats) -->
        <aside class="post-right-sidebar" aria-label="Article Outline & Author">
            <div class="sticky-sidebar-content">
                
                <!-- Author Mini Profile Card -->
                <div class="sidebar-widget author-mini-widget">
                    <div class="author-widget-header">
                        <div class="author-avatar" data-username="{{post.UserName}}">
                            {{#if post.author_image}}
                            <img src="{{post.author_image}}" alt="{{post.UserName}}">
                            {{else}}
                            <span class="avatar-initials">{{firstLetter post.UserName}}</span>
                            {{/if}}
                        </div>
                        <div class="author-widget-meta">
                            <span class="author-label">Written By</span>
                            <a href="/author/{{post.UserName}}" class="author-name">{{post.UserName}}</a>
                        </div>
                    </div>
                    <p class="author-widget-bio">Technical writer & developer at MBK Tech exploring full-stack engineering & cloud architecture.</p>
                    <a href="/author/{{post.UserName}}" class="author-widget-link">
                        <span>Articles by {{post.UserName}}</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>

                <!-- Sticky Table of Contents Container -->
                <div id="sidebarTocContainer" class="sidebar-widget toc-widget"></div>

                <!-- Reading Controls & Article Stats Widget -->
                <div class="sidebar-widget reading-stats-widget">
                    <h4 class="widget-title"><i class="fas fa-sliders-h"></i> Reading Controls</h4>
                    <div class="reading-controls-row">
                        <span class="control-label">Text Size:</span>
                        <div class="font-resizer">
                            <button class="font-resizer-btn" onclick="changeFontSize(-1)" title="Smaller text">A-</button>
                            <button class="font-resizer-btn" onclick="changeFontSize(1)" title="Larger text">A+</button>
                        </div>
                    </div>
                    <div class="reading-stats-row">
                        <div class="stat-item" title="Estimated Reading Time">
                            <i class="fas fa-clock"></i>
                            <span>{{formatReadingTime post.content_markdown}}</span>
                        </div>
                        <div class="stat-item" title="Article Views">
                            <i class="fas fa-eye"></i>
                            <span>{{post.views}} views</span>
                        </div>
                    </div>
                </div>

            </div>
        </aside>

    </div>
</div>

<!-- Floating Reading Controls (FAB) -->
<div class="floating-reading-tools">
    <button class="floating-fab" id="floatingBookmarkFab" onclick="toggleBookmark('{{post.id}}', '{{post.slug}}', '{{post.title}}')" title="Toggle Bookmark">
        <i class="far fa-bookmark"></i>
    </button>
    <button class="floating-fab scroll-top" id="scrollTopFab" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Scroll to Top">
        <i class="fas fa-arrow-up"></i>
    </button>
</div>

<!-- Fullscreen Image Lightbox Modal -->
<div class="lightbox-modal" id="imageLightbox" onclick="closeLightbox()">
    <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
    <img src="" alt="Full view" class="lightbox-img" id="lightboxImg" onclick="event.stopPropagation()">
</div>