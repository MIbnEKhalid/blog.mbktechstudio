{{#if (eq pageType "posts")}}
{{> partial/archiveMetaData}}

<div class="section-container">
    <div class="section-header">
        {{#if username}}
        <h1>Posts by {{username}}</h1>
        <p class="subtitle">Exploring articles and tutorials published by {{username}}</p>
        {{else if category}}
        <h1>{{category.name}}</h1>
        {{#if category.description}}
        <p class="description">{{category.description}}</p>
        {{else}}
        <p class="subtitle">Explore all articles in {{category.name}}</p>
        {{/if}}
        {{else}}
        <h1>#{{tag.name}}</h1>
        <p class="subtitle">All articles and resources tagged with {{tag.name}}</p>
        {{/if}}
    </div>

    {{#if posts.length}}
    {{> partial/searchAndFilter hideAuthorFilter=username hideCategoryFilter=category}}

    <div class="posts-grid" id="postsGrid">
        {{#each posts}}
        {{> partial/postCard}}
        {{/each}}
    </div>

    {{> partial/pagination}}
    {{> partial/searchAndFilterScript}}
    {{else}}
    <div class="empty-state">
        <h2>No posts found</h2>
        {{#if username}}
        <p>This author hasn't published any posts yet.</p>
        {{else if category}}
        <p>No posts have been published in this category yet.</p>
        {{else}}
        <p>No posts have been tagged with this tag yet.</p>
        {{/if}}
        <a href="/" class="btn btn-primary"><i class="fas fa-arrow-left"></i> Back to Home</a>
    </div>
    {{/if}}
</div>

{{else if (eq pageType "categories")}}
{{> partial/categoriesMetaData}}

<div class="section-container">
    <div class="section-header">
        <h1>Categories</h1>
        <p class="subtitle">Explore curated topics, engineering guides, and tutorials</p>
    </div>

    <div class="categories-grid">
        {{#each categories}}
        <a href="/category/{{encodeURIComponent this.name}}" class="category-card">
            <div class="category-card-header">
                <div class="category-icon"><i class="fas fa-folder"></i></div>
                <span class="post-count-badge">{{this.post_count}} posts</span>
            </div>
            <h2>{{trim this.name}}</h2>
            <p class="description">{{#if this.description}}{{this.description}}{{else}}Browse articles and resources in {{trim this.name}}.{{/if}}</p>
            <div class="category-card-footer">
                <span class="explore-link">Explore Category <i class="fas fa-arrow-right"></i></span>
            </div>
        </a>
        {{else}}
        <div class="empty-state" style="grid-column: 1 / -1;">
            <h2>No Categories Found</h2>
            <p>Check back later for new categories.</p>
            <a href="/" class="btn btn-primary">Back to Home</a>
        </div>
        {{/each}}
    </div>
</div>

{{else if (eq pageType "tags")}}
{{> partial/tagsMetaData}}
<div class="section-container">
    <div class="section-header">
        <h1>Tags Cloud</h1>
        <p class="subtitle">Browse articles by specific keywords and technologies</p>
    </div>

    <div class="tags-cloud-card">
        <div class="tags-cloud">
            {{#each tags}}
            <a href="/tag/{{encodeURIComponent this.name}}" class="tag-item" data-count="{{this.post_count}}">
                <span class="tag-hash">#</span>
                <span class="tag-name">{{trim this.name}}</span>
                <span class="tag-count">{{this.post_count}}</span>
            </a>
            {{else}}
            <div class="empty-state">
                <h2>No Tags Found</h2>
                <p>Check back later for new tags.</p>
                <a href="/" class="btn btn-primary">Back to Home</a>
            </div>
            {{/each}}
        </div>
    </div>
</div>
{{/if}}