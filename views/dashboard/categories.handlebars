{{#section 'styles'}}
<title>Categories Management - MBK Admin</title>
{{/section}}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Categories Management</h1>
        <p class="page-subtitle">Organize content taxonomies, view post counts, and manage structure.</p>
    </div>
</div>

<div class="dashboard-layout-grid" style="grid-template-columns: 340px 1fr;">
    <!-- LEFT: Create Category Card -->
    <div class="card-panel">
        <div class="card-header">
            <span class="card-title"><i class="fas fa-plus-circle" style="color: var(--primary);"></i> Add Category</span>
        </div>
        <div class="card-body">
            <form id="createCategoryForm">
                <div class="form-group">
                    <label class="form-label">Category Name</label>
                    <input type="text" id="newCategoryName" class="form-input" placeholder="e.g. Artificial Intelligence" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Description (Optional)</label>
                    <textarea id="newCategoryDesc" class="form-textarea" style="min-height: 80px;" placeholder="Brief description of this category..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-plus"></i> Save Category
                </button>
            </form>
        </div>
    </div>

    <!-- RIGHT: Categories Table -->
    <div class="card-panel">
        <div class="card-header">
            <div class="card-title">
                <i class="fas fa-folder" style="color: var(--accent-cyan);"></i>
                <span>Existing Categories ({{stats.total_categories}})</span>
            </div>
            <form action="/dashboard/categories" method="GET" style="display: flex; gap: 0.5rem; max-width: 250px;">
                <input type="text" name="search" class="form-input" placeholder="Search..." value="{{searchQuery}}">
            </form>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Posts Assigned</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if categories.length}}
                    {{#each categories}}
                    <tr id="catRow-{{this.id}}">
                        <td>
                            <strong style="color: var(--text-primary); font-size: 0.95rem;">{{this.name}}</strong>
                        </td>
                        <td style="color: var(--text-muted); font-size: 0.85rem;">
                            {{coalesce this.description '—'}}
                        </td>
                        <td>
                            <a href="/dashboard/posts?category={{this.id}}" class="badge badge-category" style="font-weight: 700;">
                                {{this.post_count}} Posts
                            </a>
                        </td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button onclick="openEditCategory({{jsonStringify this}})" class="btn btn-sm btn-secondary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deleteCategory({{this.id}}, '{{this.name}}', {{this.post_count}})" class="btn btn-sm btn-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                            No categories found.
                        </td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="confirm-backdrop" id="editCategoryModal">
    <div class="confirm-modal" style="text-align: left;">
        <h3 class="confirm-title" style="margin-bottom: 1.25rem;">Edit Category</h3>
        <form id="editCategoryForm">
            <input type="hidden" id="editCatId">
            <div class="form-group">
                <label class="form-label">Name</label>
                <input type="text" id="editCatName" class="form-input" required>
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea id="editCatDesc" class="form-textarea" style="min-height: 80px;"></textarea>
            </div>
            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeEditCategory()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

{{#section 'scripts'}}
<script>
    // Create Category
    document.getElementById('createCategoryForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('newCategoryName').value.trim();
        const description = document.getElementById('newCategoryDesc').value.trim();

        try {
            const res = await fetch('/dashboard/api/categories', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, description })
            });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Created', message: 'Category added' });
                setTimeout(() => window.location.reload(), 500);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to create category' });
        }
    });

    // Edit Category
    const editModal = document.getElementById('editCategoryModal');
    window.openEditCategory = function(cat) {
        document.getElementById('editCatId').value = cat.id;
        document.getElementById('editCatName').value = cat.name;
        document.getElementById('editCatDesc').value = cat.description || '';
        editModal.classList.add('active');
    };

    window.closeEditCategory = function() {
        editModal.classList.remove('active');
    };

    document.getElementById('editCategoryForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editCatId').value;
        const name = document.getElementById('editCatName').value.trim();
        const description = document.getElementById('editCatDesc').value.trim();

        try {
            const res = await fetch(`/dashboard/api/categories/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, description })
            });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Updated', message: 'Category saved' });
                closeEditCategory();
                setTimeout(() => window.location.reload(), 500);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to update category' });
        }
    });

    // Delete Category
    window.deleteCategory = function(id, name, postCount) {
        if (postCount > 0) {
            window.showToast({
                type: 'warning',
                title: 'Cannot Delete',
                message: `This category is currently linked to ${postCount} post(s). Please reassign them first.`
            });
            return;
        }

        window.showConfirm({
            title: 'Delete Category',
            message: `Delete "${name}"? This action cannot be undone.`,
            isDestructive: true,
            onConfirm: async () => {
                try {
                    const res = await fetch(`/dashboard/api/categories/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        window.showToast({ type: 'success', title: 'Deleted', message: 'Category removed' });
                        document.getElementById(`catRow-${id}`)?.remove();
                    } else {
                        window.showToast({ type: 'error', title: 'Error', message: data.message });
                    }
                } catch (e) {
                    window.showToast({ type: 'error', title: 'Error', message: 'Failed to delete category' });
                }
            }
        });
    };
</script>
{{/section}}