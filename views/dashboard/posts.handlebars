{{#section 'styles'}}
<title>Posts Management - MBK Admin</title>
<style>
    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        border-bottom: 1px solid var(--border-subtle);
        margin-bottom: 1.5rem;
        overflow-x: auto;
    }
    .filter-tab {
        padding: 0.75rem 1rem;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 2px solid transparent;
        transition: var(--transition);
        white-space: nowrap;
    }
    .filter-tab:hover {
        color: var(--text-primary);
    }
    .filter-tab.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
    }
    .filter-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }
    .search-input-wrap {
        position: relative;
        flex: 1;
        min-width: 260px;
        max-width: 400px;
    }
    .search-input-wrap i {
        position: absolute;
        left: 0.85rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-faint);
    }
    .search-input-wrap input {
        padding-left: 2.25rem;
    }
    .bulk-bar {
        display: none;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        background: var(--bg-elevated);
        border: 1px solid var(--border-medium);
        border-radius: var(--radius-md);
        margin-bottom: 1rem;
        animation: toastSlideIn 0.2s ease;
    }
    .bulk-bar.active {
        display: flex;
    }
    .post-thumb {
        width: 48px;
        height: 36px;
        border-radius: var(--radius-sm);
        object-fit: cover;
        background: var(--bg-base);
        border: 1px solid var(--border-subtle);
    }
    .post-thumb-placeholder {
        width: 48px;
        height: 36px;
        border-radius: var(--radius-sm);
        background: var(--bg-base);
        border: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-faint);
        font-size: 0.9rem;
    }
    /* Grid view */
    .posts-card-grid {
        display: none;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }
    .posts-card-grid.active {
        display: grid;
    }
    .post-card-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: var(--transition);
    }
    .post-card-item:hover {
        border-color: var(--border-hover);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }
    .post-card-cover {
        height: 160px;
        width: 100%;
        object-fit: cover;
        background: var(--bg-base);
    }
    .post-card-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    /* Quick Edit Modal */
    .quick-edit-modal-backdrop {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(8px);
        z-index: 999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .quick-edit-modal-backdrop.active {
        display: flex;
    }
    .quick-edit-modal {
        width: 520px;
        max-width: 95vw;
        background: var(--bg-surface);
        border: 1px solid var(--border-medium);
        border-radius: var(--radius-lg);
        padding: 1.75rem;
        box-shadow: var(--shadow-lg);
        animation: cmdPop 0.15s ease-out;
    }
</style>
{{/section}}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Posts Management</h1>
        <p class="page-subtitle">Publish, draft, schedule, organize and bulk edit your blog content.</p>
    </div>
    <div class="header-actions">
        <a href="/dashboard/posts/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Write New Post
        </a>
    </div>
</div>

<!-- Filter Tabs -->
<div class="filter-tabs">
    <a href="/dashboard/posts?status=all" class="filter-tab {{#if (eq filters.status 'all')}}active{{/if}}">
        <i class="fas fa-layer-group"></i> All Posts <span class="nav-badge">{{stats.total_posts}}</span>
    </a>
    <a href="/dashboard/posts?status=published" class="filter-tab {{#if (eq filters.status 'published')}}active{{/if}}">
        <i class="fas fa-check-circle" style="color: var(--success);"></i> Published <span class="nav-badge">{{stats.published_posts}}</span>
    </a>
    <a href="/dashboard/posts?status=draft" class="filter-tab {{#if (eq filters.status 'draft')}}active{{/if}}">
        <i class="fas fa-file-alt" style="color: var(--warning);"></i> Drafts <span class="nav-badge">{{stats.draft_posts}}</span>
    </a>
    <a href="/dashboard/posts?status=private" class="filter-tab {{#if (eq filters.status 'private')}}active{{/if}}">
        <i class="fas fa-lock" style="color: var(--danger);"></i> Private <span class="nav-badge">{{stats.private_posts}}</span>
    </a>
</div>

<!-- Toolbar -->
<div class="filter-toolbar">
    <form action="/dashboard/posts" method="GET" style="display: flex; gap: 0.75rem; flex: 1; flex-wrap: wrap;">
        <input type="hidden" name="status" value="{{filters.status}}">
        <div class="search-input-wrap">
            <i class="fas fa-search"></i>
            <input type="text" name="search" class="form-input" placeholder="Search by title or excerpt..." value="{{filters.search}}">
        </div>

        <select name="category" class="form-select" style="max-width: 180px;" onchange="this.form.submit()">
            <option value="all">All Categories</option>
            {{#each categories}}
            <option value="{{this.id}}" {{#if (eq ../filters.category (jsonStringify this.id))}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
        </select>

        <select name="sort" class="form-select" style="max-width: 180px;" onchange="this.form.submit()">
            <option value="newest" {{#if (eq filters.sort 'newest')}}selected{{/if}}>Newest First</option>
            <option value="oldest" {{#if (eq filters.sort 'oldest')}}selected{{/if}}>Oldest First</option>
            <option value="views_desc" {{#if (eq filters.sort 'views_desc')}}selected{{/if}}>Most Viewed</option>
            <option value="title_asc" {{#if (eq filters.sort 'title_asc')}}selected{{/if}}>Title (A-Z)</option>
        </select>

        {{#if filters.search}}
        <a href="/dashboard/posts?status={{filters.status}}" class="btn btn-secondary" title="Clear Search">
            <i class="fas fa-times"></i>
        </a>
        {{/if}}
    </form>

    <div style="display: flex; gap: 0.5rem;">
        <button class="btn btn-icon btn-secondary active" id="viewTableBtn" title="Table View">
            <i class="fas fa-list"></i>
        </button>
        <button class="btn btn-icon btn-secondary" id="viewGridBtn" title="Grid View">
            <i class="fas fa-th-large"></i>
        </button>
    </div>
</div>

<!-- Bulk Actions Floating Bar -->
<div class="bulk-bar" id="bulkActionsBar">
    <span style="font-weight: 700; color: var(--text-primary);"><span id="selectedCount">0</span> selected</span>
    <div style="display: flex; gap: 0.5rem; margin-left: auto;">
        <button class="btn btn-sm btn-secondary" onclick="executeBulkAction('publish')">
            <i class="fas fa-check"></i> Set Published
        </button>
        <button class="btn btn-sm btn-secondary" onclick="executeBulkAction('draft')">
            <i class="fas fa-file"></i> Set Draft
        </button>
        <button class="btn btn-sm btn-danger" onclick="executeBulkAction('delete')">
            <i class="fas fa-trash"></i> Delete Selected
        </button>
    </div>
</div>

<!-- Table View -->
<div class="card-panel" id="postsTableWrap">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 40px;"><input type="checkbox" id="selectAllCheckbox" title="Select All"></th>
                    <th style="width: 60px;">Image</th>
                    <th>Post Title</th>
                    <th>Categories</th>
                    <th>Status</th>
                    <th>Author</th>
                    <th>Views</th>
                    <th>Date</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#if posts.length}}
                {{#each posts}}
                <tr id="postRow-{{this.id}}">
                    <td>
                        <input type="checkbox" class="post-row-checkbox" value="{{this.id}}">
                    </td>
                    <td>
                        {{#if this.preview_image}}
                        <img src="{{this.preview_image}}" class="post-thumb" alt="Thumb" onerror="this.style.display='none'">
                        {{else}}
                        <div class="post-thumb-placeholder"><i class="fas fa-image"></i></div>
                        {{/if}}
                    </td>
                    <td>
                        <a href="/dashboard/posts/edit/{{this.id}}" style="font-weight: 600; color: var(--text-primary); font-size: 0.95rem;">
                            {{this.title}}
                        </a>
                        <div style="font-size: 0.75rem; color: var(--text-faint); margin-top: 0.15rem; font-family: var(--font-mono);">
                            /post/{{this.slug}}
                        </div>
                    </td>
                    <td>
                        <span class="badge badge-category">{{coalesce this.categories 'Uncategorized'}}</span>
                    </td>
                    <td>
                        <span class="badge badge-{{this.status}}">{{this.status}}</span>
                    </td>
                    <td style="color: var(--text-secondary); font-size: 0.85rem;">
                        {{coalesce this.author_name 'Admin'}}
                    </td>
                    <td>
                        <span style="font-family: var(--font-mono); color: var(--accent-cyan); font-weight: 600;">
                            {{formatNumber this.views}}
                        </span>
                    </td>
                    <td style="color: var(--text-muted); font-size: 0.8rem;">
                        {{formatDateShort this.created_at}}
                    </td>
                    <td style="text-align: right; white-space: nowrap;">
                        <button onclick="openQuickEdit({{jsonStringify this}})" class="btn btn-sm btn-secondary" title="Quick Edit">
                            <i class="fas fa-bolt"></i>
                        </button>
                        <a href="/dashboard/posts/edit/{{this.id}}" class="btn btn-sm btn-secondary" title="Full Editor">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button onclick="duplicatePost({{this.id}})" class="btn btn-sm btn-secondary" title="Duplicate Post">
                            <i class="fas fa-copy"></i>
                        </button>
                        <a href="/post/{{this.slug}}" target="_blank" class="btn btn-sm btn-secondary" title="View Public Post">
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                        <button onclick="deletePost({{this.id}}, '{{this.title}}')" class="btn btn-sm btn-danger" title="Delete Post">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {{/each}}
                {{else}}
                <tr>
                    <td colspan="9" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                        <i class="fas fa-folder-open" style="font-size: 2.5rem; display: block; margin-bottom: 0.75rem; opacity: 0.4;"></i>
                        No posts found matching the criteria.
                    </td>
                </tr>
                {{/if}}
            </tbody>
        </table>
    </div>
</div>

<!-- Grid View (Optional Switch) -->
<div class="posts-card-grid" id="postsGridWrap">
    {{#each posts}}
    <div class="post-card-item">
        {{#if this.preview_image}}
        <img src="{{this.preview_image}}" class="post-card-cover" alt="Cover">
        {{else}}
        <div class="post-card-cover" style="display: flex; align-items: center; justify-content: center; color: var(--text-faint);">
            <i class="fas fa-image" style="font-size: 2rem;"></i>
        </div>
        {{/if}}
        <div class="post-card-body">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span class="badge badge-category">{{coalesce this.categories 'Uncategorized'}}</span>
                <span class="badge badge-{{this.status}}">{{this.status}}</span>
            </div>
            <a href="/dashboard/posts/edit/{{this.id}}" style="font-weight: 700; color: var(--text-primary); font-size: 1.05rem; margin-bottom: 0.5rem;">
                {{this.title}}
            </a>
            <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; flex: 1;">
                {{truncate (coalesce this.excerpt this.content_markdown) 90}}
            </p>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; margin-top: 0.75rem;">
                <span style="font-size: 0.8rem; color: var(--text-faint);">{{formatDateShort this.created_at}}</span>
                <div style="display: flex; gap: 0.35rem;">
                    <a href="/dashboard/posts/edit/{{this.id}}" class="btn btn-sm btn-secondary"><i class="fas fa-edit"></i></a>
                    <button onclick="deletePost({{this.id}}, '{{this.title}}')" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>

<!-- Pagination -->
{{#if (gt pagination.totalPages 1)}}
<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
    <span style="color: var(--text-muted); font-size: 0.85rem;">
        Showing page <strong>{{pagination.page}}</strong> of <strong>{{pagination.totalPages}}</strong> ({{pagination.totalPosts}} total)
    </span>
    <div style="display: flex; gap: 0.5rem;">
        {{#if pagination.hasPrev}}
        <a href="/dashboard/posts?status={{filters.status}}&category={{filters.category}}&sort={{filters.sort}}&search={{filters.search}}&page={{pagination.prevPage}}" class="btn btn-secondary btn-sm">
            &larr; Previous
        </a>
        {{/if}}
        {{#if pagination.hasNext}}
        <a href="/dashboard/posts?status={{filters.status}}&category={{filters.category}}&sort={{filters.sort}}&search={{filters.search}}&page={{pagination.nextPage}}" class="btn btn-secondary btn-sm">
            Next &rarr;
        </a>
        {{/if}}
    </div>
</div>
{{/if}}

<!-- Quick Edit Modal -->
<div class="quick-edit-modal-backdrop" id="quickEditBackdrop">
    <div class="quick-edit-modal">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.25rem;">
            <i class="fas fa-bolt" style="color: var(--accent-amber); margin-right: 0.5rem;"></i> Quick Edit Post
        </h3>
        <form id="quickEditForm">
            <input type="hidden" id="quickEditId">
            <div class="form-group">
                <label class="form-label">Title</label>
                <input type="text" id="quickEditTitle" class="form-input" required>
            </div>
            <div class="form-group">
                <label class="form-label">Custom Slug</label>
                <input type="text" id="quickEditSlug" class="form-input" required>
            </div>
            <div class="form-group">
                <label class="form-label">Status</label>
                <select id="quickEditStatus" class="form-select">
                    <option value="published">Published</option>
                    <option value="draft">Draft</option>
                    <option value="private">Private</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Category</label>
                <select id="quickEditCategory" class="form-select">
                    <option value="">No change</option>
                    {{#each categories}}
                    <option value="{{this.id}}">{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeQuickEdit()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

{{#section 'scripts'}}
<script>
    // View switcher (Table / Grid)
    const viewTableBtn = document.getElementById('viewTableBtn');
    const viewGridBtn = document.getElementById('viewGridBtn');
    const tableWrap = document.getElementById('postsTableWrap');
    const gridWrap = document.getElementById('postsGridWrap');

    viewTableBtn?.addEventListener('click', () => {
        viewTableBtn.classList.add('active');
        viewGridBtn.classList.remove('active');
        tableWrap.style.display = 'block';
        gridWrap.classList.remove('active');
    });

    viewGridBtn?.addEventListener('click', () => {
        viewGridBtn.classList.add('active');
        viewTableBtn.classList.remove('active');
        tableWrap.style.display = 'none';
        gridWrap.classList.add('active');
    });

    // Bulk selection logic
    const selectAll = document.getElementById('selectAllCheckbox');
    const rowCheckboxes = document.querySelectorAll('.post-row-checkbox');
    const bulkBar = document.getElementById('bulkActionsBar');
    const selectedCount = document.getElementById('selectedCount');

    function updateBulkBar() {
        const checked = document.querySelectorAll('.post-row-checkbox:checked');
        if (checked.length > 0) {
            bulkBar.classList.add('active');
            selectedCount.textContent = checked.length;
        } else {
            bulkBar.classList.remove('active');
        }
    }

    selectAll?.addEventListener('change', (e) => {
        rowCheckboxes.forEach(cb => cb.checked = e.target.checked);
        updateBulkBar();
    });

    rowCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateBulkBar);
    });

    function getSelectedIds() {
        const checked = document.querySelectorAll('.post-row-checkbox:checked');
        return Array.from(checked).map(cb => parseInt(cb.value));
    }

    async function executeBulkAction(action) {
        const ids = getSelectedIds();
        if (ids.length === 0) return;

        window.showConfirm({
            title: `Bulk ${action.toUpperCase()}`,
            message: `Are you sure you want to apply "${action}" to ${ids.length} selected post(s)?`,
            isDestructive: action === 'delete',
            onConfirm: async () => {
                try {
                    const res = await fetch('/dashboard/api/posts/bulk', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action, postIds: ids })
                    });
                    const data = await res.json();
                    if (data.success) {
                        window.showToast({ type: 'success', title: 'Bulk Updated', message: data.message });
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        window.showToast({ type: 'error', title: 'Error', message: data.message });
                    }
                } catch (e) {
                    window.showToast({ type: 'error', title: 'Error', message: 'Failed to perform bulk action' });
                }
            }
        });
    }

    // Delete single post
    function deletePost(id, title) {
        window.showConfirm({
            title: 'Delete Post',
            message: `Are you sure you want to delete "${title}"? This action cannot be undone.`,
            confirmText: 'Delete Post',
            isDestructive: true,
            onConfirm: async () => {
                try {
                    const res = await fetch(`/dashboard/api/posts/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        window.showToast({ type: 'success', title: 'Deleted', message: data.message });
                        document.getElementById(`postRow-${id}`)?.remove();
                        setTimeout(() => window.location.reload(), 500);
                    } else {
                        window.showToast({ type: 'error', title: 'Error', message: data.message });
                    }
                } catch (e) {
                    window.showToast({ type: 'error', title: 'Error', message: 'Failed to delete post' });
                }
            }
        });
    }

    // Duplicate post
    async function duplicatePost(id) {
        try {
            const res = await fetch(`/dashboard/api/posts/${id}/duplicate`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Post Duplicated', message: 'Cloned as draft' });
                setTimeout(() => window.location.reload(), 600);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to duplicate post' });
        }
    }

    // Quick Edit modal
    const quickModal = document.getElementById('quickEditBackdrop');
    const quickForm = document.getElementById('quickEditForm');

    window.openQuickEdit = function(post) {
        document.getElementById('quickEditId').value = post.id;
        document.getElementById('quickEditTitle').value = post.title;
        document.getElementById('quickEditSlug').value = post.slug;
        document.getElementById('quickEditStatus').value = post.status;
        quickModal.classList.add('active');
    };

    window.closeQuickEdit = function() {
        quickModal.classList.remove('active');
    };

    quickForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('quickEditId').value;
        const title = document.getElementById('quickEditTitle').value;
        const slug = document.getElementById('quickEditSlug').value;
        const status = document.getElementById('quickEditStatus').value;
        const categoryId = document.getElementById('quickEditCategory').value;

        try {
            const res = await fetch(`/dashboard/api/posts/${id}/quick`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, slug, status, categoryId })
            });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Updated', message: 'Post updated' });
                closeQuickEdit();
                setTimeout(() => window.location.reload(), 500);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (err) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to save changes' });
        }
    });
</script>
{{/section}}