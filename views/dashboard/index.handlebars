{{#section 'styles'}}
<title>Dashboard Overview - MBK Admin</title>
<style>
    .attention-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: var(--radius-full);
        background: var(--warning-bg);
        color: var(--warning);
        border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .action-tile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .action-tile {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.75rem;
        transition: var(--transition);
    }
    .action-tile:hover {
        border-color: var(--border-hover);
        transform: translateY(-2px);
        background: var(--bg-elevated);
        box-shadow: var(--shadow-md);
    }
    .action-tile-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .timeline-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .timeline-item {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-subtle);
    }
    .timeline-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    .timeline-dot {
        width: 10px;
        height: 10px;
        border-radius: var(--radius-full);
        background: var(--primary);
        margin-top: 0.4rem;
        flex-shrink: 0;
        box-shadow: 0 0 8px var(--primary);
    }
</style>
{{/section}}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard Overview</h1>
        <p class="page-subtitle">Welcome back! Monitor your blog performance, editorial flow, and audience feedback.</p>
    </div>
    <div class="header-actions">
        <a href="/dashboard/posts/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Write Post
        </a>
        <a href="/dashboard/analytics" class="btn btn-secondary">
            <i class="fas fa-chart-bar"></i> Analytics
        </a>
    </div>
</div>

<!-- Metrics Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-title">Total Posts</span>
            <div class="stat-icon-wrap primary"><i class="fas fa-newspaper"></i></div>
        </div>
        <div class="stat-value">{{formatNumber stats.totalPosts}}</div>
        <div class="stat-footer">
            <span style="color: var(--success); font-weight: 600;">{{stats.publishedPosts}} Published</span>
            <span>&bull;</span>
            <span style="color: var(--warning); font-weight: 600;">{{stats.draftPosts}} Drafts</span>
        </div>
    </div>

    <div class="stat-card cyan">
        <div class="stat-header">
            <span class="stat-title">Total Views</span>
            <div class="stat-icon-wrap cyan"><i class="fas fa-eye"></i></div>
        </div>
        <div class="stat-value">{{formatNumber stats.totalViews}}</div>
        <div class="stat-footer">
            <span>Avg <strong>{{formatNumber stats.avgViews}}</strong> views per post</span>
        </div>
    </div>

    <div class="stat-card emerald">
        <div class="stat-header">
            <span class="stat-title">Comments</span>
            <div class="stat-icon-wrap emerald"><i class="fas fa-comments"></i></div>
        </div>
        <div class="stat-value">{{formatNumber stats.totalComments}}</div>
        <div class="stat-footer">
            <span style="color: var(--success); font-weight: 600;">{{stats.approvedComments}} Approved</span>
            {{#if (gt stats.pendingComments 0)}}
            <span>&bull;</span>
            <span style="color: var(--warning); font-weight: 600;">{{stats.pendingComments}} Pending</span>
            {{/if}}
        </div>
    </div>

    <div class="stat-card purple">
        <div class="stat-header">
            <span class="stat-title">Taxonomy</span>
            <div class="stat-icon-wrap purple"><i class="fas fa-sitemap"></i></div>
        </div>
        <div class="stat-value">{{add stats.totalCategories stats.totalTags}}</div>
        <div class="stat-footer">
            <span><strong>{{stats.totalCategories}}</strong> Categories &bull; <strong>{{stats.totalTags}}</strong> Tags</span>
        </div>
    </div>
</div>

<!-- Quick Actions Hub -->
<div class="action-tile-grid">
    <a href="/dashboard/posts/create" class="action-tile">
        <div class="action-tile-icon" style="background: var(--primary-light); color: var(--primary);">
            <i class="fas fa-pen-fancy"></i>
        </div>
        <span style="font-weight: 600; font-size: 0.9rem;">New Post</span>
    </a>
    <a href="/dashboard/comments?status=pending" class="action-tile">
        <div class="action-tile-icon" style="background: var(--warning-bg); color: var(--warning);">
            <i class="fas fa-inbox"></i>
        </div>
        <span style="font-weight: 600; font-size: 0.9rem;">Moderation Queue</span>
    </a>
    <a href="/dashboard/seo" class="action-tile">
        <div class="action-tile-icon" style="background: var(--info-bg); color: var(--info);">
            <i class="fas fa-search-plus"></i>
        </div>
        <span style="font-weight: 600; font-size: 0.9rem;">SEO Health</span>
    </a>
    <a href="/mbkbucket" class="action-tile">
        <div class="action-tile-icon" style="background: rgba(168, 85, 247, 0.15); color: var(--accent-purple);">
            <i class="fas fa-photo-video"></i>
        </div>
        <span style="font-weight: 600; font-size: 0.9rem;">Cloud Media</span>
    </a>
    <a href="/dashboard/settings" class="action-tile">
        <div class="action-tile-icon" style="background: rgba(255, 255, 255, 0.08); color: var(--text-secondary);">
            <i class="fas fa-sliders-h"></i>
        </div>
        <span style="font-weight: 600; font-size: 0.9rem;">Settings</span>
    </a>
</div>

<!-- Content Needing Attention (if any) -->
{{#if (or (gt stats.pendingComments 0) attentionItems.length)}}
<div class="card-panel" style="margin-bottom: 2rem; border-color: rgba(245, 158, 11, 0.3);">
    <div class="card-header" style="background: var(--warning-bg);">
        <div class="card-title" style="color: var(--warning);">
            <i class="fas fa-bell"></i>
            <span>Content Needing Attention</span>
        </div>
    </div>
    <div class="card-body">
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            {{#if (gt stats.pendingComments 0)}}
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: var(--bg-base); border-radius: var(--radius-md);">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-clock" style="color: var(--warning);"></i>
                    <span><strong>{{stats.pendingComments}}</strong> pending comment(s) waiting for your review.</span>
                </div>
                <a href="/dashboard/comments?status=pending" class="btn btn-sm btn-outline">Review Now &rarr;</a>
            </div>
            {{/if}}

            {{#each attentionItems}}
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: var(--bg-base); border-radius: var(--radius-md);">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-image" style="color: var(--accent-rose);"></i>
                    <span>Post <strong>"{{this.title}}"</strong> has no social cover image.</span>
                </div>
                <a href="/dashboard/posts/edit/{{this.id}}" class="btn btn-sm btn-outline">Fix Post &rarr;</a>
            </div>
            {{/each}}
        </div>
    </div>
</div>
{{/if}}

<!-- Main Dashboard Grid -->
<div class="dashboard-layout-grid">
    <!-- Left Column: Recent Posts -->
    <div class="card-panel">
        <div class="card-header">
            <div class="card-title">
                <i class="fas fa-newspaper" style="color: var(--primary);"></i>
                <span>Recent Posts</span>
            </div>
            <a href="/dashboard/posts" class="btn btn-sm btn-outline">View All</a>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Views</th>
                        <th>Date</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if recentPosts.length}}
                    {{#each recentPosts}}
                    <tr>
                        <td>
                            <a href="/dashboard/posts/edit/{{this.id}}" style="font-weight: 600; color: var(--text-primary);">
                                {{truncate this.title 45}}
                            </a>
                        </td>
                        <td>
                            <span class="badge badge-category">{{coalesce this.categories 'Uncategorized'}}</span>
                        </td>
                        <td>
                            <span class="badge badge-{{this.status}}">{{this.status}}</span>
                        </td>
                        <td>
                            <span style="font-family: var(--font-mono); color: var(--accent-cyan); font-weight: 600;">
                                <i class="fas fa-eye" style="font-size: 0.75rem;"></i> {{formatNumber this.views}}
                            </span>
                        </td>
                        <td style="color: var(--text-muted); font-size: 0.8rem;">
                            {{timeAgo this.created_at}}
                        </td>
                        <td style="text-align: right;">
                            <a href="/dashboard/posts/edit/{{this.id}}" class="btn btn-sm btn-secondary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                            No posts found. <a href="/dashboard/posts/create" style="color: var(--primary); font-weight: 600;">Create your first post!</a>
                        </td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right Column: Recent Comments & Activity -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <!-- Recent Comments -->
        <div class="card-panel">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-comments" style="color: var(--accent-emerald);"></i>
                    <span>Recent Comments</span>
                </div>
                <a href="/dashboard/comments" class="btn btn-sm btn-outline">Inbox</a>
            </div>
            <div class="card-body" style="padding: 1rem 1.25rem;">
                {{#if recentComments.length}}
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    {{#each recentComments}}
                    <div style="padding-bottom: 0.85rem; border-bottom: 1px solid var(--border-subtle); display: flex; flex-direction: column; gap: 0.35rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">
                                <i class="fas fa-user-circle" style="color: var(--text-muted); margin-right: 0.25rem;"></i>
                                {{coalesce this.UserName 'Anonymous'}}
                            </span>
                            <span style="font-size: 0.75rem; color: var(--text-faint);">{{timeAgo this.created_at}}</span>
                        </div>
                        <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4;">{{truncate this.content 80}}</p>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.2rem;">
                            <span style="font-size: 0.75rem; color: var(--text-muted);">on <em>{{truncate this.post_title 30}}</em></span>
                            {{#if this.is_approved}}
                            <span class="badge badge-published" style="font-size: 0.65rem;">Approved</span>
                            {{else}}
                            <span class="badge badge-draft" style="font-size: 0.65rem;">Pending</span>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <p style="color: var(--text-muted); text-align: center; padding: 1.5rem 0;">No comments yet.</p>
                {{/if}}
            </div>
        </div>

        <!-- Recent Activity Feed -->
        <div class="card-panel">
            <div class="card-header">
                <div class="card-title">
                    <i class="fas fa-history" style="color: var(--accent-purple);"></i>
                    <span>Activity Audit</span>
                </div>
                <a href="/dashboard/activity" class="btn btn-sm btn-outline">Log</a>
            </div>
            <div class="card-body" style="padding: 1.25rem;">
                {{#if recentActivity.length}}
                <div class="timeline-list">
                    {{#each recentActivity}}
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div style="flex: 1;">
                            <div style="font-weight: 600; font-size: 0.85rem; color: var(--text-primary);">
                                {{this.action}} {{#if this.entity_title}}&bull; <span style="color: var(--text-muted);">{{truncate this.entity_title 35}}</span>{{/if}}
                            </div>
                            <div style="font-size: 0.75rem; color: var(--text-faint); margin-top: 0.15rem;">
                                by <strong>{{this.UserName}}</strong> &bull; {{timeAgo this.created_at}}
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <p style="color: var(--text-muted); text-align: center; padding: 1rem 0;">No recent activity.</p>
                {{/if}}
            </div>
        </div>
    </div>
</div>