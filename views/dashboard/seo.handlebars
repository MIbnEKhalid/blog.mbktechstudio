{{#section 'styles'}}
<title>SEO Health & Sitemaps - MBK Admin</title>
<style>
    .score-circle {
        width: 100px;
        height: 100px;
        border-radius: var(--radius-full);
        background: conic-gradient(var(--accent-emerald) calc({{seoHealthScore}} * 1%), var(--bg-highlight) 0);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
    }
    .score-inner {
        width: 78px;
        height: 78px;
        border-radius: var(--radius-full);
        background: var(--bg-surface);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.4rem;
        color: var(--text-primary);
    }
</style>
{{/section}}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">SEO Health & Sitemaps</h1>
        <p class="page-subtitle">Audit search engine optimization, simulate social shares, and regenerate static XML sitemaps.</p>
    </div>
    <div class="header-actions">
        <button type="button" class="btn btn-primary" id="regenerateSitemapsBtn">
            <i class="fas fa-sync-alt"></i> Regenerate Sitemaps
        </button>
    </div>
</div>

<!-- Score & Quick Stats Grid -->
<div class="stats-grid" style="grid-template-columns: 280px repeat(auto-fit, minmax(200px, 1fr));">
    <!-- Overall Score -->
    <div class="stat-card" style="display: flex; align-items: center; gap: 1.5rem;">
        <div class="score-circle">
            <div class="score-inner">
                {{seoHealthScore}}%
            </div>
        </div>
        <div>
            <div style="font-weight: 700; font-size: 1.1rem; color: var(--text-primary);">SEO Health Score</div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
                Based on metadata quality across {{totalPosts}} posts.
            </div>
        </div>
    </div>

    <!-- Issue counters -->
    <div class="stat-card amber">
        <div class="stat-header">
            <span class="stat-title">Missing Excerpts</span>
            <div class="stat-icon-wrap amber"><i class="fas fa-file-alt"></i></div>
        </div>
        <div class="stat-value">{{stats.missingExcerpt}}</div>
        <div class="stat-footer"><span>Affects SERP snippet quality</span></div>
    </div>

    <div class="stat-card cyan">
        <div class="stat-header">
            <span class="stat-title">Missing Cover Images</span>
            <div class="stat-icon-wrap cyan"><i class="fas fa-image"></i></div>
        </div>
        <div class="stat-value">{{stats.missingPreviewImage}}</div>
        <div class="stat-footer"><span>Affects OpenGraph social cards</span></div>
    </div>

    <div class="stat-card purple">
        <div class="stat-header">
            <span class="stat-title">Suboptimal Titles</span>
            <div class="stat-icon-wrap purple"><i class="fas fa-heading"></i></div>
        </div>
        <div class="stat-value">{{add stats.shortTitles stats.longTitles}}</div>
        <div class="stat-footer"><span>Too short or truncated</span></div>
    </div>
</div>

<!-- Layout: Sitemaps & Posts Needing Attention -->
<div class="dashboard-layout-grid">
    <!-- Posts Needing SEO Attention -->
    <div class="card-panel">
        <div class="card-header">
            <div class="card-title">
                <i class="fas fa-exclamation-circle" style="color: var(--accent-amber);"></i>
                <span>Posts Needing SEO Attention</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Post</th>
                        <th>Detected Issues</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if postsNeedingAttention.length}}
                    {{#each postsNeedingAttention}}
                    <tr>
                        <td>
                            <a href="/dashboard/posts/edit/{{this.id}}" style="font-weight: 600; color: var(--text-primary);">
                                {{truncate this.title 40}}
                            </a>
                        </td>
                        <td>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                {{#each this.issues}}
                                <span style="font-size: 0.75rem; color: var(--warning); display: flex; align-items: center; gap: 0.35rem;">
                                    <i class="fas fa-circle" style="font-size: 0.4rem;"></i> {{this}}
                                </span>
                                {{/each}}
                            </div>
                        </td>
                        <td style="text-align: right;">
                            <a href="/dashboard/posts/edit/{{this.id}}" class="btn btn-sm btn-secondary">
                                Fix in Editor
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 2.5rem; color: var(--success);">
                            <i class="fas fa-check-circle" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                            All posts meet standard SEO metadata requirements!
                        </td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Sitemaps Management Card -->
    <div class="card-panel">
        <div class="card-header">
            <div class="card-title">
                <i class="fas fa-sitemap" style="color: var(--primary);"></i>
                <span>XML Sitemaps Directory</span>
            </div>
        </div>
        <div class="card-body">
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                {{#each sitemaps}}
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background: var(--bg-base); border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <i class="fas fa-file-code" style="color: var(--accent-cyan);"></i>
                        <span style="font-weight: 600; font-family: var(--font-mono); font-size: 0.85rem;">/{{this.name}}</span>
                    </div>
                    <div>
                        {{#if this.exists}}
                        <span class="badge badge-published">Available</span>
                        {{else}}
                        <span class="badge badge-draft">Missing</span>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>

            <div style="margin-top: 1.5rem; padding: 1rem; background: var(--bg-base); border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                <div style="font-weight: 700; font-size: 0.85rem; color: var(--text-primary); margin-bottom: 0.35rem;">
                    Robots.txt & Indexing
                </div>
                <p style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;">
                    Bot blocking middleware protects server bandwidth while serving static clean sitemaps to certified search indexers.
                </p>
                <div style="margin-top: 0.75rem;">
                    <a href="/robots.txt" target="_blank" class="btn btn-sm btn-outline">
                        <i class="fas fa-external-link-alt"></i> View /robots.txt
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{#section 'scripts'}}
<script>
    const regenBtn = document.getElementById('regenerateSitemapsBtn');
    regenBtn?.addEventListener('click', async () => {
        regenBtn.disabled = true;
        regenBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

        try {
            const res = await fetch('/dashboard/api/seo/generate-sitemaps', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Sitemaps Updated', message: data.message });
                setTimeout(() => window.location.reload(), 800);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
                regenBtn.disabled = false;
                regenBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Regenerate Sitemaps';
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to generate sitemaps' });
            regenBtn.disabled = false;
            regenBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Regenerate Sitemaps';
        }
    });
</script>
{{/section}}
