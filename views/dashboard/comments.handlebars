{{#section 'styles'}}
<title>Comments Moderation - MBK Admin</title>
<style>
    .comment-card-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: var(--transition);
        position: relative;
    }
    .comment-card-item:hover {
        border-color: var(--border-hover);
        box-shadow: var(--shadow-md);
    }
    .comment-card-item.pending-border {
        border-left: 4px solid var(--warning);
    }
    .comment-reply-box {
        display: none;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-subtle);
    }
    .comment-reply-box.active {
        display: block;
    }
</style>
{{/section}}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Comments Moderation</h1>
        <p class="page-subtitle">Moderate reader feedback, approve discussions, and reply directly as admin.</p>
    </div>
</div>

<!-- Status Filter Tabs -->
<div class="filter-tabs">
    <a href="/dashboard/comments?status=all" class="filter-tab {{#if (eq filters.status 'all')}}active{{/if}}">
        <i class="fas fa-inbox"></i> All Comments <span class="nav-badge">{{stats.total_comments}}</span>
    </a>
    <a href="/dashboard/comments?status=pending" class="filter-tab {{#if (eq filters.status 'pending')}}active{{/if}}">
        <i class="fas fa-clock" style="color: var(--warning);"></i> Pending Moderation
        {{#if (gt stats.pending_comments 0)}}
        <span class="nav-badge pending">{{stats.pending_comments}}</span>
        {{/if}}
    </a>
    <a href="/dashboard/comments?status=approved" class="filter-tab {{#if (eq filters.status 'approved')}}active{{/if}}">
        <i class="fas fa-check-circle" style="color: var(--success);"></i> Approved <span class="nav-badge">{{stats.approved_comments}}</span>
    </a>
</div>

<!-- Toolbar & Bulk Moderation -->
<div class="filter-toolbar">
    <form action="/dashboard/comments" method="GET" style="display: flex; gap: 0.75rem; flex: 1; max-width: 450px;">
        <input type="hidden" name="status" value="{{filters.status}}">
        <div class="search-input-wrap" style="max-width: 100%;">
            <i class="fas fa-search"></i>
            <input type="text" name="search" class="form-input" placeholder="Search comments by author or text..." value="{{filters.search}}">
        </div>
        {{#if filters.search}}
        <a href="/dashboard/comments?status={{filters.status}}" class="btn btn-secondary" title="Clear"><i class="fas fa-times"></i></a>
        {{/if}}
    </form>

    <div style="display: flex; gap: 0.5rem;">
        <button type="button" class="btn btn-sm btn-secondary" onclick="selectAllComments(true)">Select All</button>
        <button type="button" class="btn btn-sm btn-outline" onclick="selectAllComments(false)">Deselect</button>
    </div>
</div>

<!-- Bulk Bar -->
<div class="bulk-bar" id="commentsBulkBar">
    <span style="font-weight: 700; color: var(--text-primary);"><span id="commentSelectedCount">0</span> selected</span>
    <div style="display: flex; gap: 0.5rem; margin-left: auto;">
        <button class="btn btn-sm btn-success" onclick="bulkModerate('approve')">
            <i class="fas fa-check"></i> Approve
        </button>
        <button class="btn btn-sm btn-secondary" onclick="bulkModerate('unapprove')">
            <i class="fas fa-pause"></i> Mark Pending
        </button>
        <button class="btn btn-sm btn-danger" onclick="bulkModerate('delete')">
            <i class="fas fa-trash"></i> Delete
        </button>
    </div>
</div>

<!-- Comments List -->
<div style="display: flex; flex-direction: column; gap: 1.25rem;">
    {{#if comments.length}}
    {{#each comments}}
    <div class="comment-card-item {{#unless this.is_approved}}pending-border{{/unless}}" id="commentCard-{{this.id}}">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <input type="checkbox" class="comment-checkbox" value="{{this.id}}" onchange="updateCommentBulkBar()">
                <div class="user-avatar" style="width: 38px; height: 38px; font-size: 1rem;">
                    {{firstLetter (coalesce this.UserName 'Anonymous')}}
                </div>
                <div>
                    <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary);">
                        {{coalesce this.UserName 'Anonymous'}}
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-faint);">
                        {{timeAgo this.created_at}} &bull; {{formatDateShort this.created_at}}
                    </div>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.75rem;">
                {{#if this.is_approved}}
                <span class="badge badge-published">Approved</span>
                {{else}}
                <span class="badge badge-draft">Pending Review</span>
                {{/if}}

                <div style="display: flex; gap: 0.35rem;">
                    {{#if this.is_approved}}
                    <button onclick="moderateComment({{this.id}}, 'unapprove')" class="btn btn-sm btn-secondary" title="Mark Pending">
                        <i class="fas fa-eye-slash"></i>
                    </button>
                    {{else}}
                    <button onclick="moderateComment({{this.id}}, 'approve')" class="btn btn-sm btn-success" title="Approve Comment">
                        <i class="fas fa-check"></i> Approve
                    </button>
                    {{/if}}
                    <button onclick="toggleReplyBox({{this.id}})" class="btn btn-sm btn-secondary" title="Reply">
                        <i class="fas fa-reply"></i>
                    </button>
                    <button onclick="deleteComment({{this.id}})" class="btn btn-sm btn-danger" title="Delete">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Comment Text -->
        <div style="padding: 1rem; background: var(--bg-base); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">
            {{this.content}}
        </div>

        <!-- Post Reference -->
        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted);">
            <div>
                <i class="fas fa-file-alt" style="margin-right: 0.35rem;"></i>
                Post: <a href="/post/{{this.post_slug}}" target="_blank" style="color: var(--primary); font-weight: 600;">{{this.post_title}}</a>
            </div>
        </div>

        <!-- Admin Quick Reply Box -->
        <div class="comment-reply-box" id="replyBox-{{this.id}}">
            <div style="display: flex; gap: 0.75rem;">
                <textarea id="replyText-{{this.id}}" class="form-textarea" style="min-height: 60px;" placeholder="Write official admin reply..."></textarea>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <button type="button" class="btn btn-sm btn-primary" onclick="submitReply({{this.id}})">
                        <i class="fas fa-paper-plane"></i> Send
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="toggleReplyBox({{this.id}})">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
    {{else}}
    <div class="card-panel" style="text-align: center; padding: 3rem; color: var(--text-muted);">
        <i class="fas fa-comments" style="font-size: 3rem; display: block; margin-bottom: 1rem; opacity: 0.4;"></i>
        No comments found in this view.
    </div>
    {{/if}}
</div>

<!-- Pagination -->
{{#if (gt pagination.totalPages 1)}}
<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
    <span style="color: var(--text-muted); font-size: 0.85rem;">
        Showing page <strong>{{pagination.page}}</strong> of <strong>{{pagination.totalPages}}</strong>
    </span>
    <div style="display: flex; gap: 0.5rem;">
        {{#if pagination.hasPrev}}
        <a href="/dashboard/comments?status={{filters.status}}&search={{filters.search}}&page={{pagination.prevPage}}" class="btn btn-secondary btn-sm">&larr; Previous</a>
        {{/if}}
        {{#if pagination.hasNext}}
        <a href="/dashboard/comments?status={{filters.status}}&search={{filters.search}}&page={{pagination.nextPage}}" class="btn btn-secondary btn-sm">Next &rarr;</a>
        {{/if}}
    </div>
</div>
{{/if}}

{{#section 'scripts'}}
<script>
    const bulkBar = document.getElementById('commentsBulkBar');
    const countEl = document.getElementById('commentSelectedCount');

    window.updateCommentBulkBar = function() {
        const checked = document.querySelectorAll('.comment-checkbox:checked');
        if (checked.length > 0) {
            bulkBar.classList.add('active');
            countEl.textContent = checked.length;
        } else {
            bulkBar.classList.remove('active');
        }
    };

    window.selectAllComments = function(select) {
        document.querySelectorAll('.comment-checkbox').forEach(cb => cb.checked = select);
        updateCommentBulkBar();
    };

    function getSelectedCommentIds() {
        return Array.from(document.querySelectorAll('.comment-checkbox:checked')).map(cb => parseInt(cb.value));
    }

    window.moderateComment = async function(id, action) {
        try {
            const res = await fetch(`/dashboard/api/comments/${id}/${action}`, { method: 'PUT' });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Moderated', message: data.message });
                setTimeout(() => window.location.reload(), 500);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to update comment' });
        }
    };

    window.deleteComment = function(id) {
        window.showConfirm({
            title: 'Delete Comment',
            message: 'Are you sure you want to permanently delete this comment?',
            confirmText: 'Delete',
            isDestructive: true,
            onConfirm: async () => {
                try {
                    const res = await fetch(`/dashboard/api/comments/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        window.showToast({ type: 'success', title: 'Deleted', message: 'Comment removed' });
                        document.getElementById(`commentCard-${id}`)?.remove();
                    } else {
                        window.showToast({ type: 'error', title: 'Error', message: data.message });
                    }
                } catch (e) {
                    window.showToast({ type: 'error', title: 'Error', message: 'Failed to delete comment' });
                }
            }
        });
    };

    window.bulkModerate = function(action) {
        const ids = getSelectedCommentIds();
        if (ids.length === 0) return;

        window.showConfirm({
            title: `Bulk ${action.toUpperCase()}`,
            message: `Apply ${action} to ${ids.length} selected comment(s)?`,
            isDestructive: action === 'delete',
            onConfirm: async () => {
                try {
                    const res = await fetch('/dashboard/api/comments/bulk', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action, commentIds: ids })
                    });
                    const data = await res.json();
                    if (data.success) {
                        window.showToast({ type: 'success', title: 'Updated', message: data.message });
                        setTimeout(() => window.location.reload(), 500);
                    } else {
                        window.showToast({ type: 'error', title: 'Error', message: data.message });
                    }
                } catch (e) {
                    window.showToast({ type: 'error', title: 'Error', message: 'Failed to execute bulk action' });
                }
            }
        });
    };

    window.toggleReplyBox = function(id) {
        const box = document.getElementById(`replyBox-${id}`);
        box?.classList.toggle('active');
    };

    window.submitReply = async function(id) {
        const text = document.getElementById(`replyText-${id}`)?.value.trim();
        if (!text) {
            window.showToast({ type: 'error', title: 'Empty Reply', message: 'Please write a message first.' });
            return;
        }

        try {
            const res = await fetch(`/dashboard/api/comments/${id}/reply`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: text })
            });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Reply Sent', message: 'Your reply has been published.' });
                toggleReplyBox(id);
                setTimeout(() => window.location.reload(), 600);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to post reply' });
        }
    };
</script>
{{/section}}