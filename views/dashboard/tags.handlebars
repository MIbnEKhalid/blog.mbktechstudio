{{#section 'styles'}}
<title>Tags Management - MBK Admin</title>
{{/section}}

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Tags Management</h1>
        <p class="page-subtitle">Track keyword taxonomy, tag frequencies, and manage tags in bulk.</p>
    </div>
</div>

<div class="dashboard-layout-grid" style="grid-template-columns: 320px 1fr;">
    <!-- LEFT: Create Tag Card -->
    <div class="card-panel">
        <div class="card-header">
            <span class="card-title"><i class="fas fa-tag" style="color: var(--accent-purple);"></i> Add New Tag</span>
        </div>
        <div class="card-body">
            <form id="createTagForm">
                <div class="form-group">
                    <label class="form-label">Tag Name</label>
                    <input type="text" id="newTagName" class="form-input" placeholder="e.g. javascript" required>
                    <span style="font-size: 0.75rem; color: var(--text-faint);">Tags are automatically lowercased</span>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-plus"></i> Save Tag
                </button>
            </form>
        </div>
    </div>

    <!-- RIGHT: Tags List -->
    <div class="card-panel">
        <div class="card-header">
            <div class="card-title">
                <i class="fas fa-tags" style="color: var(--primary);"></i>
                <span>Tags Directory ({{stats.total_tags}})</span>
            </div>
            <form action="/dashboard/tags" method="GET" style="max-width: 240px;">
                <input type="text" name="search" class="form-input" placeholder="Filter tags..." value="{{searchQuery}}">
            </form>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Tag Name</th>
                        <th>Posts Frequency</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if tags.length}}
                    {{#each tags}}
                    <tr id="tagRow-{{this.id}}">
                        <td>
                            <span class="pill-tag" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">
                                #{{this.name}}
                            </span>
                        </td>
                        <td>
                            <strong style="color: var(--accent-cyan); font-family: var(--font-mono);">
                                {{this.post_count}}
                            </strong> posts
                        </td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button onclick="openEditTag({{this.id}}, '{{this.name}}')" class="btn btn-sm btn-secondary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deleteTag({{this.id}}, '{{this.name}}')" class="btn btn-sm btn-danger" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                            No tags found.
                        </td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Tag Modal -->
<div class="confirm-backdrop" id="editTagModal">
    <div class="confirm-modal" style="text-align: left;">
        <h3 class="confirm-title" style="margin-bottom: 1.25rem;">Edit Tag</h3>
        <form id="editTagForm">
            <input type="hidden" id="editTagId">
            <div class="form-group">
                <label class="form-label">Tag Name</label>
                <input type="text" id="editTagName" class="form-input" required>
            </div>
            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeEditTag()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

{{#section 'scripts'}}
<script>
    // Create Tag
    document.getElementById('createTagForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('newTagName').value.trim();

        try {
            const res = await fetch('/dashboard/api/tags', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Created', message: 'Tag added' });
                setTimeout(() => window.location.reload(), 500);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to create tag' });
        }
    });

    // Edit Tag
    const editModal = document.getElementById('editTagModal');
    window.openEditTag = function(id, name) {
        document.getElementById('editTagId').value = id;
        document.getElementById('editTagName').value = name;
        editModal.classList.add('active');
    };

    window.closeEditTag = function() {
        editModal.classList.remove('active');
    };

    document.getElementById('editTagForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editTagId').value;
        const name = document.getElementById('editTagName').value.trim();

        try {
            const res = await fetch(`/dashboard/api/tags/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            const data = await res.json();
            if (data.success) {
                window.showToast({ type: 'success', title: 'Updated', message: 'Tag saved' });
                closeEditTag();
                setTimeout(() => window.location.reload(), 500);
            } else {
                window.showToast({ type: 'error', title: 'Error', message: data.message });
            }
        } catch (e) {
            window.showToast({ type: 'error', title: 'Error', message: 'Failed to update tag' });
        }
    });

    // Delete Tag
    window.deleteTag = function(id, name) {
        window.showConfirm({
            title: 'Delete Tag',
            message: `Are you sure you want to delete tag "#${name}"? It will be unlinked from all posts.`,
            isDestructive: true,
            onConfirm: async () => {
                try {
                    const res = await fetch(`/dashboard/api/tags/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        window.showToast({ type: 'success', title: 'Deleted', message: 'Tag removed' });
                        document.getElementById(`tagRow-${id}`)?.remove();
                    } else {
                        window.showToast({ type: 'error', title: 'Error', message: data.message });
                    }
                } catch (e) {
                    window.showToast({ type: 'error', title: 'Error', message: 'Failed to delete tag' });
                }
            }
        });
    };
</script>
{{/section}}